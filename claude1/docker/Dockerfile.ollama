# Ollama with GPU support
FROM nvidia/cuda:12.3.1-base-ubuntu22.04

# Install dependencies
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Ollama
RUN curl -fsSL https://ollama.ai/install.sh | sh

# Create ollama user
RUN useradd -r -s /bin/false -m -d /home/ollama -U ollama

# Create data directory
RUN mkdir -p /home/ollama/.ollama/models && \
    chown -R ollama:ollama /home/ollama/.ollama

# Switch to ollama user
USER ollama
WORKDIR /home/ollama

# Expose Ollama port
EXPOSE 11434

# Environment variables
ENV OLLAMA_HOST=0.0.0.0
ENV OLLAMA_MODELS=/home/ollama/.ollama/models
ENV OLLAMA_KEEP_ALIVE=5m

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:11434/api/tags || exit 1

# Volume for models
VOLUME ["/home/ollama/.ollama/models"]

# Start Ollama
CMD ["ollama", "serve"]