# Model Configuration
MODEL_PATH=/media/rese/AL/flux
COMFYUI_PATH=/media/rese/AL/ComfyUI
COMFYUI_URL=http://localhost:8188
COMFYUI_OUTPUT_PATH=/media/rese/AL/ComfyUI/output

# Hugging Face Configuration (required for model downloads)
# Get your token from https://huggingface.co/settings/tokens
HUGGING_FACE_TOKEN=your_token_here

# Server Configuration
PORT=3000
SERVER_PORT=3001
NODE_ENV=development

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001

# File Storage
UPLOAD_DIR=./public/uploads
GENERATED_DIR=./public/generated
MAX_FILE_SIZE=10485760

# Generation Defaults
DEFAULT_WIDTH=512
DEFAULT_HEIGHT=512
DEFAULT_STEPS=4
DEFAULT_GUIDANCE=0.0