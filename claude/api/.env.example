# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Local LLM Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b
LMSTUDIO_HOST=ws://localhost
LMSTUDIO_PORT=1234
LMSTUDIO_DEFAULT_MODEL=
LOCALAI_HOST=http://localhost
LOCALAI_PORT=8080
LOCALAI_API_KEY=sk-localai-dummy
LOCALAI_DEFAULT_MODEL=llama3

# Cloud AI Services (Optional)
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-claude-key

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/content_db
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=your-jwt-secret
API_RATE_LIMIT=100

# Features
PRIVACY_MODE=false
ENABLE_CLOUD_FALLBACK=true

# Intelligence Layer
DISABLE_INTELLIGENCE=false
ENABLE_RESOURCE_MONITORING=true
MAX_COST_PER_REQUEST=1.0
PREFER_FREE_PROVIDERS=true
MAX_LATENCY=5000