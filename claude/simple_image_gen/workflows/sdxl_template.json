{
  "workflow_name": "SDXL with Refiner",
  "description": "SDXL workflow with optional refiner stage",
  "nodes": {
    "4": {
      "inputs": {
        "ckpt_name": "{checkpoint}"
      },
      "class_type": "CheckpointLoaderSimple"
    },
    "5": {
      "inputs": {
        "width": "{width}",
        "height": "{height}",
        "batch_size": 1
      },
      "class_type": "EmptyLatentImage"
    },
    "6": {
      "inputs": {
        "text": "{positive_prompt}",
        "clip": ["4", 1]
      },
      "class_type": "CLIPTextEncode"
    },
    "7": {
      "inputs": {
        "text": "{negative_prompt}",
        "clip": ["4", 1]
      },
      "class_type": "CLIPTextEncode"
    },
    "10": {
      "inputs": {
        "add_noise": "enable",
        "noise_seed": "{seed}",
        "steps": "{base_steps}",
        "cfg": "{cfg_scale}",
        "sampler_name": "{sampler}",
        "scheduler": "{scheduler}",
        "start_at_step": 0,
        "end_at_step": "{base_steps}",
        "return_with_leftover_noise": "enable",
        "model": ["4", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["5", 0]
      },
      "class_type": "KSamplerAdvanced"
    },
    "11": {
      "inputs": {
        "ckpt_name": "{refiner_checkpoint}"
      },
      "class_type": "CheckpointLoaderSimple",
      "is_optional": true
    },
    "12": {
      "inputs": {
        "text": "{positive_prompt}",
        "clip": ["11", 1]
      },
      "class_type": "CLIPTextEncode",
      "is_optional": true
    },
    "13": {
      "inputs": {
        "text": "{negative_prompt}",
        "clip": ["11", 1]
      },
      "class_type": "CLIPTextEncode",
      "is_optional": true
    },
    "14": {
      "inputs": {
        "add_noise": "disable",
        "noise_seed": "{seed}",
        "steps": "{total_steps}",
        "cfg": "{cfg_scale}",
        "sampler_name": "{sampler}",
        "scheduler": "{scheduler}",
        "start_at_step": "{base_steps}",
        "end_at_step": "{total_steps}",
        "return_with_leftover_noise": "disable",
        "model": ["11", 0],
        "positive": ["12", 0],
        "negative": ["13", 0],
        "latent_image": ["10", 0]
      },
      "class_type": "KSamplerAdvanced",
      "is_optional": true
    },
    "15": {
      "inputs": {
        "samples": ["14", 0],
        "vae": ["4", 2]
      },
      "class_type": "VAEDecode"
    },
    "16": {
      "inputs": {
        "filename_prefix": "simple_gui_sdxl",
        "images": ["15", 0]
      },
      "class_type": "SaveImage"
    }
  },
  "parameters": {
    "seed": "random",
    "base_steps": 25,
    "total_steps": 30,
    "cfg_scale": 7.0,
    "sampler": "dpmpp_2m",
    "scheduler": "karras",
    "checkpoint": "sd_xl_base_1.0.safetensors",
    "refiner_checkpoint": "sd_xl_refiner_1.0.safetensors",
    "width": 1024,
    "height": 1024,
    "positive_prompt": "",
    "negative_prompt": "blurry, bad quality, distorted",
    "use_refiner": true
  }
}